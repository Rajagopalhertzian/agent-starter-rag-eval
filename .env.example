# RAG Agent Starter Kit - Environment Configuration
# Copy to .env and modify as needed

# LLM Configuration (Ollama local by default)
MODEL_API_BASE=http://localhost:11434/v1
MODEL_API_KEY=ollama
MODEL_NAME=qwen2.5-coder:7b
MODEL_TEMPERATURE=0.1

# Embedding Configuration
EMBEDDING_API_BASE=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=rag_documents

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Document Ingestion
DOCS_DIR=./data/docs
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Eval
EVAL_JUDGE_MODEL=qwen2.5-coder:7b
EVAL_JUDGE_API_BASE=http://localhost:11434/v1
EVAL_JUDGE_API_KEY=ollama

# Optional: NVIDIA API (cloud fallback)
# NVIDIA_API_KEY=your_key_here